# =========================
# Runtime / API
# =========================
# Local Vite dev: leave VITE_API_URL empty to use the /api proxy.
# Production: set VITE_API_URL to your deployed backend origin, for example:
# VITE_API_URL=https://your-backend.vercel.app
VITE_API_URL=
VITE_PROXY_API_URL=http://localhost:3000

# =========================
# Supabase Realtime
# =========================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =========================
# Firebase Web App
# =========================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# =========================
# PayPal Plans
# =========================
VITE_PAYPAL_CURRENCY=USD
VITE_PAYPAL_PLUS_MONTHLY_PLAN_ID=your-paypal-plus-monthly-plan-id
VITE_PAYPAL_PLUS_YEARLY_PLAN_ID=your-paypal-plus-yearly-plan-id
VITE_PAYPAL_PRO_MONTHLY_PLAN_ID=your-paypal-pro-monthly-plan-id
VITE_PAYPAL_PRO_YEARLY_PLAN_ID=your-paypal-pro-yearly-plan-id
VITE_PAYPAL_MASTER_MONTHLY_PLAN_ID=your-paypal-master-monthly-plan-id
VITE_PAYPAL_MASTER_YEARLY_PLAN_ID=your-paypal-master-yearly-plan-id
