# =========================
# Public URLs / Cookies
# =========================
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated additional frontend deployment or preview origins.
FRONTEND_URLS=
# Preview domains must be listed exactly in FRONTEND_URLS. Prefix matching is disabled.
# Keep false in production unless a local frontend must call the deployed backend.
ALLOW_LOCAL_CORS=false
BACKEND_PUBLIC_URL=http://localhost:3000
# Production HTTPS should use true.
COOKIE_SECURE=false

# =========================
# Supabase
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=chessarena
# Optional, only for npm run db:upgrade. Use the PostgreSQL connection string from Supabase Connect.
# Keep the database password on the backend; never copy this into Frontend/.env.
DATABASE_URL=
RATE_LIMIT_BACKEND=supabase
CRON_SECRET=

# =========================
# Firebase Admin
# =========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# =========================
# AI Coach
# =========================
AI_COACH_PROVIDER=multi
AI_COACH_PROVIDER_ORDER=openrouter,gemini,groq,local
AI_COACH_RATE_LIMIT_PER_MINUTE=20
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_RPM=
GEMINI_CHAT_RPD=
GROQ_API_KEY=your-groq-api-key
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_RPM=
GROQ_CHAT_RPD=
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
OPENROUTER_CHAT_RPM=
OPENROUTER_CHAT_RPD=

# =========================
# Email / OTP
# =========================
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
# Independent random secret (32+ characters); no database-key fallback.
OTP_SECRET=

# =========================
# Admin / Test Access
# =========================
# Production should use false unless you intentionally expose seeded test accounts.
ENABLE_TEST_ACCOUNTS=true
ADMIN_TEST_ACCESS_GRANTED=false
ADMIN_ROOT_EMAILS=owner@example.com
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-password
# Must differ from OTP_SECRET and database credentials (32+ random characters).
ADMIN_SESSION_SECRET=

# =========================
# PayPal
# =========================
# Production should use PAYPAL_ENV=live and plan IDs from the same live REST app.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PLUS_MONTHLY_PLAN_ID=your-paypal-plus-monthly-plan-id
PAYPAL_PLUS_YEARLY_PLAN_ID=your-paypal-plus-yearly-plan-id
PAYPAL_PRO_MONTHLY_PLAN_ID=your-paypal-pro-monthly-plan-id
PAYPAL_PRO_YEARLY_PLAN_ID=your-paypal-pro-yearly-plan-id
PAYPAL_MASTER_MONTHLY_PLAN_ID=your-paypal-master-monthly-plan-id
PAYPAL_MASTER_YEARLY_PLAN_ID=your-paypal-master-yearly-plan-id

# =========================
# Matchmaking Workers / Alerts
# =========================
# One shared local backend should use global so both networks share the same pool.
MATCHMAKING_REGION=global
MATCHMAKING_DISCORD_WEBHOOK_URL=
MATCHMAKING_SLACK_WEBHOOK_URL=
MATCHMAKING_WORKER_POLL_MS=100
MATCHMAKING_WORKER_BATCH=50
MATCHMAKING_WORKER_CONCURRENCY=10
# Optional comma-separated shard ownership, e.g. 0,1,2,3. Empty processes all 64 shards.
MATCHMAKING_WORKER_SHARDS=
MATCHMAKING_OUTBOX_POLL_MS=500
MATCHMAKING_OUTBOX_BATCH=50

# Stockfish 18: bundled by npm ci. Empty path uses the portable full WASM engine.
STOCKFISH_PATH=
# full (default) or lite (less memory, weaker analysis)
STOCKFISH_EDITION=full
# Empty = automatic, usually 2. Each worker uses one CPU thread. Range: 1-8.
STOCKFISH_POOL_SIZE=
# Hash memory per worker; WASM/NNUE memory is additional.
STOCKFISH_HASH_MB=64
STOCKFISH_REVIEW_MOVETIME=180
