FRONTEND_URL=http://localhost:5173
# Optional: comma-separated additional frontend deployment or preview origins.
FRONTEND_URLS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
OTP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
ADMIN_ROOT_EMAILS=owner@example.com
ADMIN_ROLE_ASSIGNMENTS=owner@example.com:owner
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-admin-session-secret
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PLUS_MONTHLY_PLAN_ID=your-paypal-plus-monthly-plan-id
PAYPAL_PLUS_YEARLY_PLAN_ID=your-paypal-plus-yearly-plan-id
PAYPAL_PRO_MONTHLY_PLAN_ID=your-paypal-pro-monthly-plan-id
PAYPAL_PRO_YEARLY_PLAN_ID=your-paypal-pro-yearly-plan-id
PAYPAL_MASTER_MONTHLY_PLAN_ID=your-paypal-master-monthly-plan-id
PAYPAL_MASTER_YEARLY_PLAN_ID=your-paypal-master-yearly-plan-id
