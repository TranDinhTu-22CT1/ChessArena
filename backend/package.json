{
  "name": "chess-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:security": "node --env-file-if-exists=.env scripts/check-security-config.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src next.config.mjs --max-warnings=0",
    "test": "node --test tests/*.test.js",
    "check:engine": "node --env-file-if-exists=.env scripts/check-engine.mjs",
    "check:puzzles": "node scripts/audit-puzzle-catalog.mjs",
    "knowledge:build": "node scripts/build-chess-openings.mjs",
    "knowledge:check": "node --test tests/coach-knowledge.test.js tests/coach-conversation.test.js tests/coach-scope.test.js tests/ai-coach-intent.test.js tests/integration/chat-grounding.test.js",
    "check:coach": "node --env-file-if-exists=.env scripts/check-coach.mjs",
    "stress:matchmaking": "node --env-file=.env scripts/matchmaking-stress.mjs",
    "worker:matchmaking": "node --env-file=.env scripts/matchmaking-worker.mjs",
    "worker:matchmaking-outbox": "node --env-file=.env scripts/matchmaking-outbox-worker.mjs",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:upgrade": "node --env-file=.env scripts/database-upgrade.mjs --apply",
    "check:platform": "node --env-file=.env scripts/check-platform.mjs",
    "worker:membership": "node --env-file=.env scripts/membership-worker.mjs",
    "db:check": "node scripts/database-upgrade.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "chess.js": "^1.4.0",
    "firebase-admin": "^13.10.0",
    "next": "^16.1.0",
    "nodemailer": "^8.0.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.2",
    "pg": "^8.23.0"
  }
}
